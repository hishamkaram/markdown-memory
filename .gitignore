# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches and per-user agent settings
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.claude/settings.local.json

# Not where the index goes any more - it is keyed on the documentation root and lives
# under $XDG_DATA_HOME - but a relative MARKDOWN_MEMORY_DB still resolves inside the
# repository, so this keeps a deliberately local database out of a commit.
.markdown-memory/

# A plugin or hook that passed ":memory:" where a path was expected once created a
# file with that name in the repository root. It is not ours and nothing reads it.
:memory:*
